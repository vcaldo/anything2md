# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        anything2md_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter
  # :command.environment_variables_default
  export OUTPUT_FORMAT="${OUTPUT_FORMAT:-markdown}"
  export OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
  export DEBUG="${DEBUG:-0}"

  env_var_names+=("OUTPUT_FORMAT")
  env_var_names+=("OUTPUT_DIR")
  env_var_names+=("VRAM")
  env_var_names+=("LLM_SERVICE")
  env_var_names+=("GEMINI_API_KEY")
  env_var_names+=("ANTHROPIC_API_KEY")
  env_var_names+=("OPENAI_API_KEY")
  env_var_names+=("OLLAMA_URL")
  env_var_names+=("DEBUG")

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    convert | c)
      action="convert"
      shift
      anything2md_convert_parse_requirements "$@"
      shift $#
      ;;

    batch | b)
      action="batch"
      shift
      anything2md_batch_parse_requirements "$@"
      shift $#
      ;;

    config)
      action="config"
      shift
      anything2md_config_parse_requirements "$@"
      shift $#
      ;;

    completions)
      action="completions"
      shift
      anything2md_completions_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      anything2md_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

