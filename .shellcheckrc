# shellcheck configuration for anything2md CLI project
# This file configures shellcheck for bash scripts generated by bashly

# Specify the shell dialect
shell=bash

# Set minimum severity level (error, warning, info, style)
severity=warning

# Add source path for library sourcing
source-path=src/lib

# Optionally disable specific rules that conflict with bashly patterns
# (Add specific SC codes here if needed after running shellcheck)
